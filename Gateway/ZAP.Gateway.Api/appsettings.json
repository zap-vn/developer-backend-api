{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "swagger-auth": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/Auth/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Auth"
          }
        ]
      },
      "swagger-hr": {
        "ClusterId": "hr-cluster",
        "Match": {
          "Path": "/api/Employees/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Employees"
          }
        ]
      },
      "swagger-customer": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/Customer/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Customer"
          }
        ]
      },
      "swagger-sales": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/Sales/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Sales"
          }
        ]
      },
      "swagger-products": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/Products/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Products"
          }
        ]
      },
      "swagger-orders": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/Orders/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Orders"
          }
        ]
      },
      "swagger-payments": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/Payments/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Payments"
          }
        ]
      },
      "swagger-organizations": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/Organizations/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Organizations"
          }
        ]
      },
      "swagger-reports": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/Reports/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Reports"
          }
        ]
      },
      "swagger-promotions": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/Promotions/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Promotions"
          }
        ]
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },
      "hr-route": {
        "ClusterId": "hr-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Employees/{**catch-all}"
        }
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Customer/{**catch-all}"
        }
      },
      "sales-route": {
        "ClusterId": "sales-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Sales/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "sales-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Products/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "sales-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Orders/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "sales-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Payments/{**catch-all}"
        }
      },
      "organizations-route": {
        "ClusterId": "sales-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Organizations/{**catch-all}"
        }
      },
      "reports-route": {
        "ClusterId": "sales-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Reports/{**catch-all}"
        }
      },
      "promotions-route": {
        "ClusterId": "sales-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Promotions/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "hr-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "sales-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}