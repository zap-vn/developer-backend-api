{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "your-super-secret-key-that-should-be-at-least-32-characters-long",
    "Issuer": "Zap.Identity.Api",
    "Audience": "Zap.Client"
  },
  "ReverseProxy": {
    "Routes": {
      "login-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/Authentication/login"
        },
        "Transforms": [
          {
            "PathSet": "/api/auth/login"
          }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPrefix": "/api"
          },
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-http": {
            "Address": "http://localhost:5271"
          }
        }
      }
    }
  }
}