{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:5271"
  },
  "ReverseProxy": {
    "Routes": {
      "login-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/identity/login"
        },
        "Transforms": [
          {
            "PathSet": "/api/auth/login"
          }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPrefix": "/api"
          },
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-http": {
            "Address": "http://localhost:5271"
          }
        }
      }
    }
  }
}