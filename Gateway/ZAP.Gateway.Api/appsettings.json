{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "swagger-auth": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/Auth/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Auth"
          }
        ]
      },
      "swagger-hr": {
        "ClusterId": "hr-cluster",
        "Match": {
          "Path": "/api/Employees/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Employees"
          }
        ]
      },
      "swagger-customer": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/Customer/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Customer"
          }
        ]
      },
      "swagger-sales": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/Sales/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Sales"
          }
        ]
      },
      "swagger-product": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/Product/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Product"
          }
        ]
      },
      "swagger-order": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/Order/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Order"
          }
        ]
      },
      "swagger-payment": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/Payment/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Payment"
          }
        ]
      },
      "swagger-organization": {
        "ClusterId": "organization-cluster",
        "Match": {
          "Path": "/api/Organization/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Organization"
          }
        ]
      },
      "swagger-report": {
        "ClusterId": "report-cluster",
        "Match": {
          "Path": "/api/Report/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/Report"
          }
        ]
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },
      "hr-route": {
        "ClusterId": "hr-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Employees/{**catch-all}"
        }
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Customer/{**catch-all}"
        }
      },
      "sales-route": {
        "ClusterId": "sales-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Sales/{**catch-all}"
        }
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Product/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Order/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Payment/{**catch-all}"
        }
      },
      "organization-route": {
        "ClusterId": "organization-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Organization/{**catch-all}"
        }
      },
      "report-route": {
        "ClusterId": "report-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/Report/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "hr-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "sales-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5006"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5007"
          }
        }
      },
      "organization-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5008"
          }
        }
      },
      "report-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5009"
          }
        }
      }
    }
  }
}